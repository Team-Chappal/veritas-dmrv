#!/usr/bin/env bash
# VERITAS dMRV — pre-push hook.
#
# Installed by `make install-git-hooks`. It refuses to push a commit to `main`
# that did not come through a merged pull request.
#
# WHY THIS EXISTS RATHER THAN A REMINDER
#
# Twice, a commit reached main with no PR and no CI, both times from a `git push`
# with no refspec inside a command chain. ci-gate.py protects MERGES and could not
# see either. A written rule was already in AGENTS.md and did not prevent it
# twice, because a rule competes with a chain of shell commands for attention and
# loses.
#
# So the check is in front of the push, and says why.
#
# Uninstall: make uninstall-git-hooks

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Only when the push actually touches main. A branch push is unaffected.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  # Deleting the remote branch is not a push to main.
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # A push that does not move main forward (e.g. a no-op ref update) is not the
  # case this hook exists for.
  if [[ "$local_sha" == "$remote_sha" ]]; then
    continue
  fi

  echo ""
  echo "pre-push: checking that every commit landing on main came from a PR"
  echo ""

  commits=0
  failures=0
  unverified=0
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # First push to an empty main: check the single head commit.
    revs=("$local_sha")
  else
    revs=()
    while read -r c; do revs+=("$c"); done < <(git rev-list "$remote_sha..$local_sha")
  fi

  for sha in "${revs[@]}"; do
    commits=$((commits + 1))
    subject="$(git log -1 --format=%s "$sha")"
    if [[ "$subject" == "Merge branch"* || "$subject" == "Merge pull request"* || "$subject" == "Revert "* ]]; then
      echo "  exempt  $sha  $subject"
      continue
    fi
    if [[ "$subject" =~ \(#([0-9]+)\)$ ]]; then
      pr="${BASH_REMATCH[1]}"
      if ! command -v gh >/dev/null 2>&1; then
        # Fail CLOSED, but say so differently from a genuine rejection. An early
        # version warned and let the push through here while blocking on a
        # genuinely-unmerged PR, so the hook was advisory about the one case that
        # mattered most.
        echo "  BLOCKED $sha  PR #$pr referenced, but the gh CLI is not installed"
        echo "           so the PR state could not be confirmed"
        unverified=$((unverified + 1))
        failures=$((failures + 1))
        continue
      fi
      state="$(gh pr view "$pr" --json state -q .state 2>/dev/null || echo UNRESOLVED)"
      if [[ "$state" == "MERGED" ]]; then
        echo "  ok      $sha  PR #$pr merged"
        continue
      fi
      if [[ "$state" == "UNRESOLVED" ]]; then
        # "I could not check" is not the same claim as "the PR is not merged",
        # and the hook used to report both as BLOCKED with one message, so a
        # repository with no GitHub remote looked identical to a policy
        # violation. Now the two are distinguishable, which is the difference
        # between a guard and an obstacle.
        echo "  BLOCKED $sha  PR #$pr could not be resolved from here"
        echo "           (no usable remote, offline, or gh cannot see it)"
        unverified=$((unverified + 1))
        failures=$((failures + 1))
        continue
      fi
      echo "  BLOCKED $sha  PR #$pr is $state, not MERGED"
      failures=$((failures + 1))
    else
      echo "  BLOCKED $sha  no pull-request reference in the subject"
      failures=$((failures + 1))
    fi
  done

  if (( failures > 0 )); then
    echo ""
    echo "pre-push: $failures of $commits commit(s) on main have no merged PR behind them."
    if (( unverified > 0 )); then
      echo ""
      echo "  $unverified of those could not be VERIFIED rather than rejected --"
      echo "  the PR state was unreachable. That is not the same as a violation,"
      echo "  and it usually means the gh CLI is not authenticated, there is no"
      echo "  GitHub remote here, or the network is down."
      echo ""
      echo "  Re-authenticate and retry:  gh auth status"
    fi
    echo ""
    echo "  Every commit lands as a PR. Open one, or -- if this is a correction to"
    echo "  already-merged work -- re-land it the same way: a branch, a PR, and a"
    echo "  merge through scripts/ci-gate.py."
    echo ""
    echo "  To override deliberately: git push --no-verify"
    echo ""
    exit 1
  fi

  echo "pre-push: $commits commit(s) checked, all accounted for."
  echo ""
done

exit 0
