# VERITAS dMRV — environment template
#
# Copy to backend/.env and frontend/.env.local, then fill in.
# EVERY Cloudinary variable is optional. With all of them unset the platform
# runs in FIXTURE MODE: every remote call degrades to a local fallback, and the
# full demo still works. That is deliberate — a stage demo must never depend on
# a credential, and credential absence must be a supported state, not a crash.

# --- Cloudinary (optional) --------------------------------------------------
# When all three are set, mode = "live". Otherwise mode = "fixture".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Webhook notification signing. Cloudinary signs notifications with an API
# SECRET, not a separate webhook key: sha1(body + X-Cld-Timestamp + secret).
# Usually identical to CLOUDINARY_API_SECRET -- set it separately only if you
# have designated a DEDICATED API key for webhooks
# (Console > Settings > Webhooks > Select API Key).
CLOUDINARY_WEBHOOK_SECRET=

# --- Authentication --------------------------------------------------------
# Signing key for VERITAS JWTs. UNSET is supported outside production, where a
# random per-process key is used and tokens do not survive a restart. In
# PRODUCTION this is mandatory: without it protected routes fail closed (503).
# Generate one with:  openssl rand -base64 48
VERITAS_JWT_SECRET=

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Cryptographic provenance (optional) ------------------------------------
# ES256 private key for C2PA manifest signing. Unset => c2pa_provenance is
# reported as C2PA_MISSING rather than silently claiming verification.
C2PA_SIGNING_PRIVATE_KEY=

# --- Demo safety ------------------------------------------------------------
# When true, the frontend prefers pre-cached IndexedDB assets over live
# Cloudinary calls. This is the fail-safe for stage Wi-Fi failure.
DEMO_CACHE_ENABLED=true
